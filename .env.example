# 이 파일은 "변수 이름"만 적는 견본입니다. 값은 절대 적지 마세요.
# 로컬: 이 파일을 .env.local 로 복사한 뒤 값을 채웁니다(.env.local 은 저장소 제외).
# 배포: Vercel 프로젝트 > Settings > Environment Variables 에 등록합니다.

# 관리자 로그인 비밀번호
ADMIN_PASSWORD=
# 관리자 토큰 서명용 비밀값(32자 이상 무작위 문자열 권장)
TOKEN_SECRET=

# Turso — 로컬에서는 비워 두면 ./local.db 를 사용합니다. 배포 환경에서는 필수.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
